# MySQL connection. URL-encode special characters in the password (@ -> %40).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/bitsofwellness-db"
# Long random string used to sign admin login sessions.
SESSION_SECRET="change-me-to-a-long-random-string"
# Shared key the mobile app sends in the x-app-key header.
APP_API_KEY="change-me"
# Public URL of this admin panel (used to build absolute image URLs for the app).
PUBLIC_BASE_URL="https://admin.example.com"
# Where uploaded images are stored on disk.
UPLOAD_DIR="./storage/uploads"

# First admin account created by `npm run db:seed`.
ADMIN_EMAIL="admin@bitsofwellness.com"
ADMIN_PASSWORD="choose-a-strong-password"
